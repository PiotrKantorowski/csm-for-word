<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CSM.RevisionSidecar</AssemblyName>
    <RootNamespace>CSM.RevisionSidecar</RootNamespace>
    <!-- Allow test project to reference this Exe project -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Clippit: maintained .NET 6+/8 fork of OpenXmlPowerTools.
         Provides: OpenXmlRegex, WmlComparer, RevisionAccepter, WmlDocument,
         OpenXmlMemoryStreamDocument, GetXDocument/PutXDocument extensions.
         Clippit pulls in DocumentFormat.OpenXml >= 3.5.1 as a transitive dep. -->
    <PackageReference Include="Clippit" Version="3.4.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Allow the xUnit test project to access internal members -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSM.RevisionSidecar.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
