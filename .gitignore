backups/20*/
sessions/
maps/
logs/
runtime/backups/*
runtime/sessions/*
!runtime/backups/.keep
!runtime/sessions/.keep

# Installer output
installer/output/
*.exe

# Python/package/build outputs
build/
dist/
*.egg-info/
.coverage
